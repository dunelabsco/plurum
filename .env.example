# Supabase - CRITICAL: Use Transaction Pooler (port 6543) for serverless scaling
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.your-project.supabase.co:6543/postgres
# ^ Port 6543 = Transaction Pooler (required for FastAPI)
# ^ Port 5432 = Direct Session (DO NOT USE for serverless)

SUPABASE_KEY=your-service-role-key
OPENAI_API_KEY=sk-...

# API Configuration
API_KEY_PREFIX=plrm_live_
RATE_LIMIT_STANDARD=100
RATE_LIMIT_PREMIUM=1000
RATE_LIMIT_UNLIMITED=10000

# Hosted MCP transport security (JSON arrays)
# Emergency rollback: set MCP_ENABLED=false and restart/redeploy the backend.
MCP_ENABLED=true
MCP_ALLOWED_HOSTS='["localhost:*","127.0.0.1:*"]'
MCP_ALLOWED_ORIGINS='["http://localhost:*","http://127.0.0.1:*"]'
MCP_MAX_RESPONSE_BODY_BYTES=10485760
# Keep OAuth off until the Supabase OAuth server, access-token hook, and
# browser consent flow have all passed the isolated canary.
MCP_OAUTH_ENABLED=false
MCP_OAUTH_RESOURCE_URL=https://mcp.plurum.ai/mcp
MCP_OAUTH_MAX_BEARER_TOKEN_BYTES=8192

# Environment
ENVIRONMENT=development
DEBUG=true
